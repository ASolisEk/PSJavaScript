{
  "expo": {
    "name": "PSJavaScript",
    "slug": "PSJavaScript",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.psjavascript.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.psjavascript.app",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "PSJavaScript",
      "shortName": "PSJS",
      "lang": "es",
      "themeColor": "#58cc02",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "psjavascript",
    "experiments": {
      "typedRoutes": true
    },
    "description": "Entorno para aprender a programar con JavaScript, inspirado en PSeInt: ejecución paso a paso, prueba de escritorio, diagramas de flujo y exportación a otros lenguajes."
  }
}
